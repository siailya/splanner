{
  "name": "delivery-planner",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "nuxt dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "bun run generate && bun run build:server",
    "build:server": "esbuild server/index.ts server/cli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=.output/server --out-extension:.js=.mjs",
    "start": "node .output/server/index.mjs",
    "admin": "tsx server/cli.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.server.json",
    "lint": "eslint app server tests nuxt.config.ts playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "vitest run tests/performance"
  },
  "dependencies": {
    "@nuxt/ui": "latest",
    "@pinia/nuxt": "latest",
    "@vueuse/nuxt": "latest",
    "better-sqlite3": "^13.0.3",
    "dexie": "latest",
    "dhtmlx-gantt": "latest",
    "express": "^5.2.1",
    "nuxt": "latest",
    "pinia": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@iconify-json/lucide": "latest",
    "@nuxt/test-utils": "latest",
    "@playwright/test": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "@vue/test-utils": "latest",
    "esbuild": "^0.28.2",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.2",
    "fake-indexeddb": "latest",
    "fast-check": "4.3.0",
    "happy-dom": "latest",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
